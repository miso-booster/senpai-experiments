{
  "model_label": "deepseek-chat",
  "variables": {
    "automation_root": "/path/to/automated-prompt-interface"
  },
  "defaults": {
    "cwd": "/path/to/SENPAI/{project_dir}/Senpai-Assistant",
    "cmd": [
      "{cwd}/.venv/Scripts/python.exe",
      "-m",
      "app.main"
    ],
    "env_file": "{automation_root}/configs/.env",
    "env": {
      "SENPAI_MODEL": "deepseek-chat",
      "SENPAI_MODEL_PROVIDER": "openai",
      "SENPAI_MODEL_BASE_URL": "https://api.deepseek.com",
      "SENPAI_STRUCTURED_OUTPUT_METHOD": "function_calling"
    }
  },
  "architectures": [
    {
      "id": "agentic_architecture",
      "project_dir": "agentic"
    },
    {
      "id": "graph_based_architecture",
      "project_dir": "graph_based"
    },
    {
      "id": "one_node_architecture",
      "project_dir": "one_node"
    }
  ]
}
